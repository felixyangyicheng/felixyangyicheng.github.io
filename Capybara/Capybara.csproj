<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>       
	    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
		<BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
		<BlazorWasmPrerenderingDeleteLoadingContents>true</BlazorWasmPrerenderingDeleteLoadingContents>	
		<BlazorWasmPrerenderingMode>WebAssemblyPrerendered</BlazorWasmPrerenderingMode>
		<PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
		<RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
		<WasmStripILAfterAOT Condition="'$(Configuration)' == 'Release'">true</WasmStripILAfterAOT>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="Docs\AMD_Ollama\amd_rocm_ollama_rx6500xt-fr.md" />
      <Content Include="Docs\CaddyServer\BasicCaddyfileSample-fr.md" />
      <Content Include="Docs\Cockpit\Cockpit_installation-fr.md" />
      <Content Include="Docs\Jenkins\BashSample_AutomatedDockerComposeDeployment-fr.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />

		<PackageReference Include="BootstrapBlazor" Version="10.4.0" />
		<PackageReference Include="BootstrapBlazor.Markdown" Version="10.0.0" />
		<PackageReference Include="Heron.MudCalendar" Version="4.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.5.26302.115" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-preview.5.26302.115" PrivateAssets="all" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-preview.5.26302.115" />
	    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.5.26302.115" />    
		<PackageReference Include="MudBlazor" Version="9.1.0" />
        <PackageReference Include="BlazorPro.Spinkit" Version="1.2.0" />
        <PackageReference Include="ReactorBlazorQRCodeScanner" Version="1.0.10" />

        <PackageReference Include="ToolBelt.Blazor.SpeechSynthesis" Version="11.0.0" />
	    <PackageReference Include="ToolBelt.Web.CssClassInlineBuilder" Version="3.1.0.1" />
	    <PackageReference Include="Toolbelt.Blazor.PWA.Updater" Version="3.2.0" />
	    <PackageReference Include="ZXingBlazor" Version="1.1.5" />
		<PackageReference Include="CodeBeam.MudBlazor.Extensions" Version="9.0.2" />
    </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Models\Dominos\" />
    <Folder Include="wwwroot\docs\" />
    <Folder Include="wwwroot\public\" />
  </ItemGroup>
</Project>
