@page "/guessflag"
@inject HttpClient _httpClient
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    @if (IsLoading)
    {
        <Pulse />
    }
    else if (!IsGameStarted)
    {
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h5">Drapeaux de France</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Devinez la région, le département ou le territoire avant la fin du temps.
                    </MudText>

                    <MudSelect T="int" Class="mt-4" Label="Nombre de manches" @bind-Value="RoundCount">
                        <MudSelectItem T="int" Value="@(5)">5</MudSelectItem>
                        <MudSelectItem T="int" Value="@(10)">10</MudSelectItem>
                        <MudSelectItem T="int" Value="@(15)">15</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="int" Class="mt-3" Label="Secondes par drapeau" @bind-Value="SecondsPerRound">
                        <MudSelectItem T="int" Value="@(20)">20</MudSelectItem>
                        <MudSelectItem T="int" Value="@(30)">30</MudSelectItem>
                        <MudSelectItem T="int" Value="@(45)">45</MudSelectItem>
                    </MudSelect>

                    <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NewGame" Disabled="@(!CanStart)">
                        Commencer
                    </MudButton>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4" Elevation="0">
                    <MudText Typo="Typo.h6">Objectif</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Une bonne réponse donne 100 points, plus un bonus de temps et un bonus de série.
                        Un indice coûte 25 points. Une erreur de temps ou un passage coûte une vie.
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else if (IsGameFinished)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h4">Partie terminée</MudText>
            <MudText Typo="Typo.h6" Class="mt-2">Score final: @Points</MudText>
            <MudText Typo="Typo.body2">Bonnes réponses: @CorrectCount / @FlagsViewed.Count</MudText>
            <MudText Typo="Typo.body2">Meilleure série: @BestStreak</MudText>

            <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled" OnClick="NewGame">
                Rejouer
            </MudButton>
        </MudPaper>

        @ResultHistory()
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="1">
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.h6">Manche @CurrentRound / @RoundCount</MudText>
                        <MudChip T="string" Color="@TimerColor">@TimeText</MudChip>
                    </div>

                    <MudProgressLinear Class="mt-3" Color="@TimerColor" Value="@TimeProgress" />

                    <div class="flag-stage mt-4">
                        @if (!string.IsNullOrWhiteSpace(CurrentFlagImage))
                        {
                            <MudImage Class="flag-image" Src="@CurrentFlagImage" Alt="Drapeau à deviner" />
                        }
                    </div>

                    <MudText Typo="Typo.caption" Class="mt-3">Réponse</MudText>
                    <IndividualLetterComboInput @key="@($"{RegionToGuess.Code}-{CurrentRound}")" OnWordOk="NextFlag" StringInit="@RegionToGuess.Region" />

                    @if (!string.IsNullOrWhiteSpace(HintText))
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-3">@HintText</MudAlert>
                    }

                    @if (!string.IsNullOrWhiteSpace(LastFeedback))
                    {
                        <MudAlert Severity="@LastFeedbackSeverity" Class="mt-3">@LastFeedback</MudAlert>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="UseHint" Disabled="@HintUsed">
                            Indice (-25)
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="SkipFlag">
                            Passer
                        </MudButton>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6">Score</MudText>
                    <MudText Typo="Typo.h4">@Points</MudText>
                    <MudDivider Class="my-3" />
                    <MudText>Vies: @Lives</MudText>
                    <MudText>Série: @CurrentStreak</MudText>
                    <MudText>Restants: @ListToGuess.Count</MudText>
                </MudPaper>

                @ResultHistory()
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private RenderFragment ResultHistory() => @<MudPaper Class="pa-4 mt-4 viewed" Elevation="1">
        <MudText Typo="Typo.h6">Historique</MudText>
        @if (FlagsViewed.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mt-2">Aucun drapeau joué.</MudText>
        }
        else
        {
            @foreach (var result in FlagsViewed)
            {
                <div class="history-row">
                    <MudIcon Color="@(result.Correct ? Color.Success : Color.Error)"
                             Icon="@(result.Correct ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" />
                    <MudImage Width="56" Src="@GetFlagImage(result)" />
                    <div>
                        <MudText Typo="Typo.body2">@result.Region</MudText>
                        <MudText Typo="Typo.caption">#@result.Order</MudText>
                    </div>
                </div>
            }
        }
    </MudPaper>;
}

<style>
    .flag-stage {
        display: flex;
        min-height: 220px;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-background-grey);
    }

    .flag-image {
        max-width: min(420px, 100%);
        max-height: 210px;
        object-fit: contain;
    }

    .viewed {
        max-height: 55vh;
        overflow-y: auto;
    }

    .history-row {
        display: grid;
        grid-template-columns: 28px 56px 1fr;
        gap: 10px;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }
</style>
