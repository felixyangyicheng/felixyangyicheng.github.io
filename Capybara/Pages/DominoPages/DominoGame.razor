@page "/domino/game/create/{NumberOfPlayers:int}/{MaxPip:int}"
@page "/domino/game/{RoomCode:int}"

@using Capybara.Components.Dominos
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    @if (currentGame is null)
    {
        <MudProgressCircular Indeterminate="true" />
        <MudText Class="mt-3">Connexion à la salle...</MudText>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h5">Salle @currentGame.HostId.ToString("0000")</MudText>
                    <MudText Typo="Typo.body2">Jeu 0 - @currentGame.MaxPip, @currentGame.TotalDominoes pièces</MudText>
                    <MudText Typo="Typo.body2">@currentGame.DominosPerPlayer pièces par joueur, @currentGame.BoneyardCount hors jeu</MudText>
                    <MudText Typo="Typo.body2">Joueurs: @currentGame.Players.Count / @currentGame.NumberOfPlayers</MudText>

                    @if (currentGame.Status == "Waiting")
                    {
                        <MudDivider Class="my-4" />
                        <MudTextField @bind-Value="playerName"
                                      Label="Votre nom"
                                      Variant="Variant.Outlined"
                                      Immediate="true" />
                        <MudButton Class="mt-3"
                                   FullWidth
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@IsAlreadyJoined"
                                   OnClick="JoinGame">
                            Rejoindre la partie
                        </MudButton>
                        <MudText Class="mt-3" Typo="Typo.caption">Partagez ce code à 4 chiffres aux autres joueurs.</MudText>
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.h6">Joueurs</MudText>
                    @foreach (var player in currentGame.Players)
                    {
                        <div class="d-flex justify-space-between align-center mt-2">
                            <MudText Color="@(IsCurrentTurn(player) ? Color.Primary : Color.Default)">
                                @(IsCurrentTurn(player) ? "> " : "")@player.Name
                            </MudText>
                            <MudText Typo="Typo.caption">@player.Hand.Count pièces</MudText>
                        </div>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                @if (currentGame.Status == "Ended")
                {
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.h5">Partie terminée</MudText>
                        <MudText>Gagnant: @currentGame.WinnerName</MudText>
                        <MudText>Raison: @currentGame.EndReason</MudText>

                        <MudTable Items="@currentGame.Statistics" Dense="true" Hover="true" Class="mt-4">
                            <HeaderContent>
                                <MudTh>Joueur</MudTh>
                                <MudTh>Score</MudTh>
                                <MudTh>Restantes</MudTh>
                                <MudTh>Points en main</MudTh>
                                <MudTh>Placées</MudTh>
                                <MudTh>Passes</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@(context.IsWinner ? "Winner - " : "")@context.PlayerName</MudTd>
                                <MudTd>@context.Score</MudTd>
                                <MudTd>@context.RemainingDominoes</MudTd>
                                <MudTd>@context.RemainingPips</MudTd>
                                <MudTd>@context.PlayedCount</MudTd>
                                <MudTd>@context.PassedCount</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }
                else if (currentGame.Status == "Playing")
                {
                    <MudPaper Class="pa-4" Elevation="1">
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.h6">Plateau</MudText>
                            <MudText Typo="Typo.body2">
                                Tête: @(currentGame.ValueFirst?.ToString() ?? "-") |
                                Queue: @(currentGame.ValueLast?.ToString() ?? "-")
                            </MudText>
                        </div>

                        <div class="domino-board mt-3">
                            @if (currentGame.Board.Count == 0)
                            {
                                <MudText Typo="Typo.body2">Le premier joueur peut poser n'importe quelle pièce.</MudText>
                            }
                            else
                            {
                                @foreach (var domino in currentGame.Board)
                                {
                                    <Piece Domino="domino" />
                                }
                            }
                        </div>
                    </MudPaper>

                    <MudPaper Class="pa-4 mt-4" Elevation="1">
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.h6">Votre main</MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       Disabled="@(!CanCurrentPlayerAct)"
                                       OnClick="PassTurn">
                                Passer
                            </MudButton>
                        </div>

                        @if (currentPlayer is null)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-3">Rejoignez la salle pour jouer.</MudAlert>
                        }
                        else
                        {
                            <div class="domino-hand mt-3">
                                @foreach (var domino in currentPlayer.Hand)
                                {
                                    <MudPaper Class="pa-2 domino-hand-item" Elevation="0">
                                        <Piece Domino="domino" />
                                        <div class="d-flex gap-2 mt-2">
                                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
                                                           Color="Color.Primary"
                                                           Disabled="@(!CanPlayAtHead(domino))"
                                                           OnClick="@(() => PlayDomino(domino, true))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                                                           Color="Color.Primary"
                                                           Disabled="@(!CanPlayAtTail(domino))"
                                                           OnClick="@(() => PlayDomino(domino, false))" />
                                        </div>
                                    </MudPaper>
                                }
                            </div>
                        }
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.h6">En attente des joueurs</MudText>
                        <MudText>La partie démarre automatiquement quand la salle est pleine.</MudText>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<style>
    .domino-board,
    .domino-hand {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .domino-hand-item {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
    }
</style>

@code {
    [Parameter] public int? RoomCode { get; set; }
    [Parameter] public int NumberOfPlayers { get; set; }
    [Parameter] public int MaxPip { get; set; }

    [NotNull]
    private HubConnection _hub = default!;

    private Game? currentGame;
    private Player? currentPlayer;
    private string playerName = "";

    private bool IsAlreadyJoined => currentPlayer is not null;
    private bool CanCurrentPlayerAct => currentGame?.Status == "Playing" &&
                                        currentPlayer is not null &&
                                        currentGame.Players.ElementAtOrDefault(currentGame.CurrentPlayerIndex)?.ConnectionId == currentPlayer.ConnectionId;

    protected override async Task OnInitializedAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl($"{Configuration["dominogame.srv"]}/game")
            .WithAutomaticReconnect()
            .Build();

        _hub.On<Game>("GameCreated", UpdateGame);
        _hub.On<Game>("GameJoined", UpdateGame);
        _hub.On<Game>("GameStarted", UpdateGame);
        _hub.On<Game>("GameUpdated", UpdateGame);
        _hub.On<Game, Player, Domino>("DominoPlayed", (game, _, _) => UpdateGame(game));
        _hub.On<Game, Player>("TurnPassed", (game, _) => UpdateGame(game));
        _hub.On<Game>("GameEnded", UpdateGame);
        _hub.On<string>("InvalidMove", message => Snackbar.Add(message, Severity.Warning));
        _hub.On<string>("GameError", message => Snackbar.Add(message, Severity.Error));
        _hub.On<Player>("PlayerDisconnected", _ => InvokeAsync(StateHasChanged));

        await _hub.StartAsync();

        if (RoomCode.HasValue)
        {
            await _hub.SendAsync("GetGame", RoomCode.Value);
        }
        else
        {
            var roomCode = await _hub.InvokeAsync<int>("CreateGame", NumberOfPlayers, MaxPip);
            Navigation.NavigateTo($"/domino/game/{roomCode}", replace: true);
        }
    }

    private void UpdateGame(Game game)
    {
        currentGame = game;
        currentPlayer = currentGame.Players.FirstOrDefault(p => p.ConnectionId == _hub.ConnectionId);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task JoinGame()
    {
        if (currentGame is null)
        {
            return;
        }

        await _hub.SendAsync("JoinGame", playerName, currentGame.HostId);
    }

    private async Task PlayDomino(Domino domino, bool toHead)
    {
        if (currentGame is null)
        {
            return;
        }

        await _hub.SendAsync("PlayDomino", currentGame.HostId, domino.Value1, domino.Value2, toHead);
    }

    private async Task PassTurn()
    {
        if (currentGame is null)
        {
            return;
        }

        await _hub.SendAsync("PassTurn", currentGame.HostId);
    }

    private bool IsCurrentTurn(Player player)
    {
        return currentGame?.Status == "Playing" &&
               currentGame.Players.ElementAtOrDefault(currentGame.CurrentPlayerIndex)?.ConnectionId == player.ConnectionId;
    }

    private bool CanPlayAtHead(Domino domino)
    {
        return CanCurrentPlayerAct &&
               (currentGame?.Board.Count == 0 ||
                domino.Value1 == currentGame?.ValueFirst ||
                domino.Value2 == currentGame?.ValueFirst);
    }

    private bool CanPlayAtTail(Domino domino)
    {
        return CanCurrentPlayerAct &&
               (currentGame?.Board.Count == 0 ||
                domino.Value1 == currentGame?.ValueLast ||
                domino.Value2 == currentGame?.ValueLast);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
